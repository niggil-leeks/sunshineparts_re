<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorBackground">@color/parts_background</item>
        <item name="android:windowBackground">@color/parts_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:colorControlActivated">@color/parts_accent</item>
        <item name="android:colorAccent">@color/parts_accent</item>
        <item name="android:statusBarColor">@color/parts_background</item>
        <item name="android:navigationBarColor">@color/parts_background</item>
        <item name="android:windowLightStatusBar">@bool/parts_light</item>
        <item name="android:windowLightNavigationBar">@bool/parts_light</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/parts_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
